# --- LLM ---
# bedrock = Claude on Amazon Bedrock (default; credentials from ~/.aws locally, the instance role on EC2);
# cloudflare = Workers AI (free daily allowance; uses CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_AI_TOKEN below);
# anthropic = Claude API (needs Anthropic credits).
LLM_PROVIDER=bedrock
# A cross-region inference profile ID. Others that work on this account: us.amazon.nova-2-lite-v1:0,
# us.anthropic.claude-sonnet-4-5-20250929-v1:0 (claude-haiku-5-5 is listed but "not available for this account")
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Locally the bot uses the default profile in ~/.aws; on EC2 it uses the instance role.
AWS_REGION=us-east-1
# Tested in simulated calls: gpt-oss-120b was the most accurate (uses tools, no invented bookings) but can be slow.
# qwen3-30b-a3b-fp8 is faster with thinking off (CF_LLM_THINKING=false) but then invents hours and fake bookings.
# Avoid llama-3.3-70b (refuses chat when tools are offered), llama-4-scout (speaks tool calls as text), gpt-oss-20b.
CF_LLM_MODEL=@cf/openai/gpt-oss-120b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# Only for keys not scoped to a workspace (sk-ant-usr-...): the workspace ID (wrkspc_...) from Console > Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=

# --- Real-time speech-to-text (Pipecat bot) ---
DEEPGRAM_API_KEY=

# --- Speech (real-time calls) ---
# STT: flux = Deepgram Flux with built-in end-of-turn detection (default); nova = Deepgram Nova + local VAD/turn analyzer.
STT_PROVIDER=flux
# Start the reply on Flux's predicted end of turn. Off: in testing it gave no measurable speed-up and caused
# doubled replies with the Workers AI model. Worth retrying with Claude.
FLUX_EAGER_EOT=false
# TTS: deepgram = Aura-2 streamed over a WebSocket (default, fastest; uses DEEPGRAM_API_KEY);
#      cloudflare = Workers AI Aura (free daily allowance); voxcpm = VoxCPM2 on Modal (needs a Modal payment method).
TTS_PROVIDER=deepgram
# Aura-2 voices, e.g. aura-2-asteria-en, aura-2-thalia-en, aura-2-luna-en, aura-2-helena-en, aura-2-apollo-en, aura-2-arcas-en
DEEPGRAM_TTS_VOICE=aura-2-asteria-en
# Account ID from the Cloudflare dashboard; API token with the "Workers AI: Read" and "Workers AI: Edit" permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Models: @cf/deepgram/aura-1 (speakers: asteria, luna, stella, athena, hera, orion, arcas, perseus, angus, orpheus, helios, zeus)
#         @cf/deepgram/aura-2-en (more natural, about twice the cost per character)
CF_TTS_MODEL=@cf/deepgram/aura-1
CF_TTS_SPEAKER=asteria

# --- VoxCPM2 TTS on Modal (printed by `modal deploy tts/modal_app.py`, no trailing slash) ---
VOXCPM_URL=https://<workspace>--voxcpm-tts-tts-web.modal.run
VOXCPM_TOKEN=

# --- Voice-note speech-to-text: the existing cloudflare-stt Worker ---
STT_BASE_URL=https://<your-stt-worker>.workers.dev
STT_API_KEY=

# --- openwa gateway (existing openwa-api container) ---
OPENWA_URL=http://openwa-api:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=voice-test
# Comma-separated numbers allowed to talk to the bot (digits only, e.g. 27821234567). Empty = anyone.
ALLOWED_PHONE_NUMBERS=

# --- n8n ---
# Shared secret between the bot and n8n's tool / post-call webhooks.
TOOLS_SECRET=
# Owner account you create on first n8n login; used by n8n-activator.
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=

# --- WhatsApp Business Calling (Meta Cloud API) — used by `bot.py --whatsapp` ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=

# --- WebRTC behind NAT (EC2) ---
# Lets the bot learn its public IP. Set on the server; leave empty locally.
PIPECAT_ICE_SERVERS=

# Cloudflare named tunnel "voice-agent" -> https://voice-agent.njmtech.co.za (routes to http://localhost:7860)
CF_TUNNEL_TOKEN=

# Postgres for call records (docker-compose `db`); any long random string
DB_PASSWORD=
# Metabase dashboard (server only): database role passwords and the admin login password
METABASE_DB_PASSWORD=
DASHBOARD_DB_PASSWORD=
METABASE_ADMIN_PASSWORD=
# Business name used in WhatsApp booking confirmations
BUSINESS_NAME=Demo Co
